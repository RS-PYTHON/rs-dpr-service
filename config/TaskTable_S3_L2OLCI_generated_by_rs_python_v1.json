{
  "$schema": "./../schemas/TaskTable.schema.json",
  "tasktable": {
    "name": "s3-olci-l2",
    "version": "1.5.0",
    "specification_version": "1.0_draftJ",
    "update_datetime": "2026-08-19T15:00:00Z",
    "configuration_path": {}
  },
  "external_variables": [
    "start_datetime",
    "end_datetime"
  ],
  "units": [
    {
      "name": "OL2Processor",
      "module": "s3olci.s3_ol2.ol2_processor",
      "resources_min": {
        "dask": {
          "worker_cpu": 1.0,
          "worker_ram": "20GB",
          "worker_thread_count": 1,
          "worker_count": 1
        },
        "disk": {
          "size_per_worker": "50GB"
        }
      },
      "input_products": [
        {
          "name": "S3OLCIL1",
          "mode": "always",
          "mandatory": true
        }
      ],
      "input_adfs": [
        {
          "name": "OLPPP",
          "mode": "always",
          "mandatory": true
        },
        {
          "name": "OLPCP",
          "mode": "always",
          "mandatory": true
        },
        {
          "name": "OLCLP",
          "mode": "always",
          "mandatory": true
        },
        {
          "name": "OLWVP",
          "mode": "always",
          "mandatory": true
        },
        {
          "name": "OLVGP",
          "mode": "always",
          "mandatory": true
        }
      ],
      "output_products": [
        {
          "name": "S3OLCIL2",
          "mode": "always",
          "mandatory": true
        }
      ]
    }
  ],
  "io": [
    {
      "name": "S3OLCIL1",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      }
    },
    {
      "name": "S3OLCIL2",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      }
    },
    {
      "name": "OLPCP",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      },
      "alternatives": [
        {
          "order": 1,
          "timeout_seconds": 180,
          "query": {
            "name": "LatestValIntersect",
            "parameters": {
              "product_type": "ADF_OLPCP",
              "start_datetime": "{external_variable.start_datetime}",
              "end_datetime": "{external_variable.end_datetime}",
              "dTa": 0,
              "dTb": 0
            }
          }
        }
      ]
    },
    {
      "name": "OLPPP",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      },
      "alternatives": [
        {
          "order": 1,
          "timeout_seconds": 180,
          "query": {
            "name": "LatestValIntersect",
            "parameters": {
              "product_type": "ADF_OLPPP",
              "start_datetime": "{external_variable.start_datetime}",
              "end_datetime": "{external_variable.end_datetime}",
              "dTa": 0,
              "dTb": 0
            }
          }
        }
      ]
    },
    {
      "name": "OLWVP",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      },
      "alternatives": [
        {
          "order": 1,
          "timeout_seconds": 180,
          "query": {
            "name": "LatestValIntersect",
            "parameters": {
              "product_type": "ADF_OLWVP",
              "start_datetime": "{external_variable.start_datetime}",
              "end_datetime": "{external_variable.end_datetime}",
              "dTa": 0,
              "dTb": 0
            }
          }
        }
      ]
    },
    {
      "name": "OLVGP",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      },
      "alternatives": [
        {
          "order": 1,
          "timeout_seconds": 180,
          "query": {
            "name": "LatestValIntersect",
            "parameters": {
              "product_type": "ADF_OLVGP",
              "start_datetime": "{external_variable.start_datetime}",
              "end_datetime": "{external_variable.end_datetime}",
              "dTa": 0,
              "dTb": 0
            }
          }
        }
      ]
    },
    {
      "name": "OLCLP",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      },
      "alternatives": [
        {
          "order": 1,
          "timeout_seconds": 180,
          "query": {
            "name": "LatestValIntersect",
            "parameters": {
              "product_type": "ADF_OLCLP",
              "start_datetime": "{external_variable.start_datetime}",
              "end_datetime": "{external_variable.end_datetime}",
              "dTa": 0,
              "dTb": 0
            }
          }
        }
      ]
    }
  ],
  "queries": [
    {
      "name": "ValIntersect",
      "parameters": [
        "product_type",
        "start_datetime",
        "end_datetime",
        "dTa",
        "dTb"
      ],
      "stac": {
        "filter": {
          "op": "and",
          "args": [
            {
              "op": "=",
              "args": [
                {
                  "property": "product:type"
                },
                "{product_type}"
              ]
            },
            {
              "op": "t_intersects",
              "args": [
                {
                  "interval": [
                    {
                      "property": "start_datetime"
                    },
                    {
                      "property": "end_datetime"
                    }
                  ]
                },
                {
                  "interval": [
                    {
                      "op": "-",
                      "args": [
                        "{start_datetime}",
                        "{dTa}"
                      ]
                    },
                    {
                      "op": "+",
                      "args": [
                        "{end_datetime}",
                        "{dTb}"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "LatestValIntersect",
      "parameters": [
        "product_type",
        "start_datetime",
        "end_datetime",
        "dTa",
        "dTb"
      ],
      "stac": {
        "filter": {
          "op": "and",
          "args": [
            {
              "op": "=",
              "args": [
                {
                  "property": "product:type"
                },
                "{product_type}"
              ]
            },
            {
              "op": "t_intersects",
              "args": [
                {
                  "interval": [
                    {
                      "property": "start_datetime"
                    },
                    {
                      "property": "end_datetime"
                    }
                  ]
                },
                {
                  "interval": [
                    {
                      "op": "-",
                      "args": [
                        "{start_datetime}",
                        "{dTa}"
                      ]
                    },
                    {
                      "op": "+",
                      "args": [
                        "{end_datetime}",
                        "{dTb}"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "sortby": [
          {
            "field": "created",
            "direction": "desc"
          }
        ],
        "limit": 1
      }
    }
  ],
  "pipelines": [
    {
      "name": "ol2",
      "description": "Full Sentinel-3 OLCI L2 processing",
      "steps": [
        {
          "unit_name": "OL2Processor",
          "step_id": 1,
          "input_products": {
            "S3OLCIL1": "pipeline_input"
          },
          "output_products": {
            "S3OLCIL2": "pipeline_output"
          }
        }
      ]
    }
  ]
}
