  "io": [
    {
      "name": "slcs",
      "type": "file",
      "engine": "cpm_zarr",
      "opening_mode": "CREATE_OVERWRITE"
    },
    {
      "name": "REFERENCE_DB",
      "type": "folder",
      "engine": "cpm_zarr"
    },
    {
      "name": "ETAD",
      "type": "folder",
      "engine": "cpm_zarr",
      "multiplicity": "one_per_input",
      "alternatives": [
          {
              "order": 1,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCoverWithSatellite",
                  "parameters": {
                      "product_type": "{external_variable.instrument_mode}_ETA__AX",
                      "start_datetime": "{slcs.start_datetime}",
                      "end_datetime": "{slcs.end_datetime}",
                      "satellite": "{slcs.platform}",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          }
      ]
    },
    {
      "name": "ORBIT",
      "type": "folder",
      "multiplicity": "one_per_input",
      "alternatives": [
          {
              "order": 1,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValidity",
                  "parameters": {
                      "product_type": "MPL_ORBSCT",
                      "satellite": "{slcs.platform}"
                  }
              }
          },
          {
              "order": 2,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCoverWithSatellite",
                  "parameters": {
                      "product_type": "AUX_POEORB",
                      "start_datetime": "{slcs.start_datetime}",
                      "end_datetime": "{slcs.end_datetime}",
                      "satellite": "{slcs.platform}",
