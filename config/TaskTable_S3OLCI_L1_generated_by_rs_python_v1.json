                      ]
                    },
                    {
                      "op": "+",
                      "args": [
                        "{end_datetime}",
                        "{dTb}"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "sortby": [
          {
            "field": "created",
            "direction": "desc"
          }
        ],
        "limit": 1
