{
    "$schema": "../schemas/TaskTable.schema.json",
    "tasktable": {
        "name": "s3-l0",
        "version": "1.0",
        "specification_version": "2.0_draftA",
        "update_datetime": "2026-11-09T15:00:00Z",
        "configuration_path": {}
    },
    "external_modules": [
        {
            "name": "l0.cadu_processing.cadu_reader",
            "star_import": true
        }
    ],
    "external_variables": [
        "start_datetime",
        "end_datetime",
        "satellite"
    ],
    "units": [
        {
            "name": "S3L0Processor",
            "module": "l0.s3.s3_l0_processor",
            "resources_min": {
                "dask": {
                    "worker_cpu": 4,
                    "worker_ram": "58GB",
                    "worker_thread_count": 1,
                    "worker_count": 1
                },
                "disk": {
                    "size_per_worker": "50GB"
                }
            },
            "input_products": [
                {
                    "name": "S3ACADUS",
                    "mode": "always",
                    "mandatory": true
                }
            ],
            "input_adfs": [
                {
                    "name": "osf",
                    "mode": "always",
                    "mandatory": false
                },
                {
                    "name": "fro",
                    "mode": "always",
                    "mandatory": false
                },
                {
                    "name": "adf_l0cfg",
                    "mode": "always",
                    "mandatory": false
                }
            ],
            "output_products": [
                {
                    "name": "S03ISPS",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^(?!cache).*"
                },
                {
                    "name": "S03CACHE",
                    "mode": "always",
                    "final_product": false,
                    "mandatory": true,
                    "regex": "cache.*"
                }
            ]
        }
    ],
    "io": {
        "input": [
            {
                "name": "S3ACADUS",
                "type": "file",
                "engine": "cadu"
            }
        ],
        "adfs": [
            {
                "name": "osf",
                "type": "file",
                "engine": "cpm_safe",
                "alternatives": [
                    {
                        "order": 1,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
                            "parameters": {
                                "product_type": "AX___OSF_AX",
                                "start_datetime": "{external_variable.start_datetime}",
                                "end_datetime": "{external_variable.end_datetime}",
                                "satellite": "{external_variable.satellite}",
                                "dTa": 6000,
                                "dTb": 6000
                            }
                        }
                    }
                ]
            },
            {
                "name": "fro",
                "type": "file",
                "engine": "cpm_safe",
                "alternatives": [
                    {
                        "order": 1,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
                            "parameters": {
                                "product_type": "AX___FRO_AX",
                                "start_datetime": "{external_variable.start_datetime}",
                                "end_datetime": "{external_variable.end_datetime}",
                                "satellite": "{external_variable.satellite}",
                                "dTa": 7000,
                                "dTb": 7000
                            }
                        }
                    }
                ]
            },
            {
                "name": "adf_l0cfg",
                "type": "file",
                "alternatives": [
                    {
                        "order": 1,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
                            "parameters": {
                                "product_type": "ADF_L0CFG",
                                "start_datetime": "{external_variable.start_datetime}",
                                "end_datetime": "{external_variable.end_datetime}",
                                "satellite": "{external_variable.satellite}",
                                "dTa": 0,
                                "dTb": 0
                            }
                        }
                    }
                ]
            }
        ],
        "output": [
            {
                "name": "S03ISPS",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03CACHE",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            }
        ]
    },
    "queries": [
        {
            "name": "LatestValCover",
            "parameters": [
                "product_type",
                "start_datetime",
                "end_datetime",
                "satellite",
                "dTa",
                "dTb"
            ],
            "stac": {
                "filter": {
                    "op": "and",
                    "args": [
                        {
                            "op": "=",
                            "args": [
                                {
                                    "property": "product:type"
                                },
                                "{product_type}"
                            ]
                        },
                        {
                            "op": "=",
                            "args": [
                                {
                                    "property": "platform"
                                },
                                "{satellite}"
                            ]
                        },
                        {
                            "op": "t_contains",
                            "args": [
                                {
                                    "interval": [
                                        {
                                            "property": "start_datetime"
                                        },
                                        {
                                            "property": "end_datetime"
                                        }
                                    ]
                                },
                                {
                                    "interval": [
                                        {
                                            "op": "-",
                                            "args": [
                                                "{start_datetime}",
                                                "{dTa}"
                                            ]
                                        },
                                        {
                                            "op": "+",
                                            "args": [
                                                "{end_datetime}",
                                                "{dTb}"
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "sortby": [
                    {
                        "field": "created",
                        "direction": "desc"
                    }
                ],
                "limit": 1
            }
        }
    ],
    "pipelines": [
        {
            "name": "s3_l0_full",
            "description": "Full pipeline for S3 L0",
            "steps": [
                {
                    "unit_name": "S3L0Processor",
                    "step_id": 1,
                    "input_products": {
                        "S3ACADUS": "pipeline_input"
                    },
                    "output_products": {
                        "S03ISPS": "pipeline_output",
                        "S03CACHE": "pipeline_internal"
                    },
                    "parameters": {
                        "temporary_path": "./S3_D_TDS_1/output/tmp",
                        "acquisition_report_output_path": "./S3_D_TDS_1/output/default/Report/",
                        "ignore_output": "S03CACHE",
                        "cadu_chunk_size": {
                            "navatt": 10000,
                            "olci": 10000,
                            "slstr": 10000,
                            "sral": 10000,
                            "mwr": 10000,
                            "gnss": 10000,
                            "doris": 10000,
                            "hktm": 10000,
                            "hktm_tf": 10000
                        },
                        "isp_chunk_size": {
                            "S03NAT_IG": 10000,
                            "S03OLCCIG": 10000,
                            "S03OLC0IG": 10000,
                            "S03OLC1IG": 10000,
                            "S03OLC_IG": 10000,
                            "S03SLS_IG": 10000,
                            "S03SRA_IG": 10000,
                            "S03SRACIG": 10000,
                            "S03MWR_IG": 10000,
                            "S03GNS_IG": 10000,
                            "S03DORNIG": 10000,
                            "S03DORDIG": 10000,
                            "S03HKM_IG": 10000,
                            "S03HKM2IG": 10000,
                            "S03NATL0_": 10000,
                            "S03OLCCR0": 10000,
                            "S03OLCCR1": 10000,
                            "S03OLCL0_": 10000,
                            "S03SLSL0_": 10000,
                            "S03SRAL0C": 10000,
                            "S03SRAL0_": 10000,
                            "S03MWRL0_": 10000,
                            "S03GNSL0_": 10000,
                            "S03DORNAV": 10000,
                            "S03DORDOP": 10000,
                            "S03HKML0_": 10000,
                            "S03HKM2L0": 10000
                        }
                    }
                }
            ]
        }
    ]
}
