                            "S03HKM_IG": 10000,
                            "S03HKM2IG": 10000,
                            "S03NATL0_": 10000,
                            "S03OLCCR0": 10000,
                            "S03OLCCR1": 10000,
                            "S03OLCL0_": 10000,
                            "S03SLSL0_": 10000,
                            "S03SRAL0C": 10000,
                            "S03SRAL0_": 10000,
