{
    "$schema": "../schemas/TaskTable.schema.json",
    "tasktable": {
        "name": "s3-l0",
        "version": "1.0",
        "specification_version": "2.0_draftA",
        "update_datetime": "2026-11-09T15:00:00Z",
        "configuration_path": {}
    },
    "external_modules": [
        {
            "name": "l0.cadu_processing.cadu_reader",
            "star_import": true
        }
    ],
    "external_variables": [
        "start_datetime",
        "end_datetime",
        "satellite"
    ],
    "units": [
        {
            "name": "S3L0Processor",
            "module": "l0.s3.s3_l0_processor",
            "resources_min": {
                "dask": {
                    "worker_cpu": 4,
                    "worker_ram": "58GB",
                    "worker_thread_count": 1,
                    "worker_count": 1
                },
                "disk": {
                    "size_per_worker": "50GB"
                }
            },
            "input_products": [
                {
                    "name": "S3ACADUS",
                    "mode": "always",
                    "mandatory": true
                }
            ],
            "input_adfs": [
                {
                    "name": "osf",
                    "mode": "always",
                    "mandatory": false
                },
                {
                    "name": "fro",
                    "mode": "always",
                    "mandatory": false
                }
            ],
            "output_products": [
                {
                    "name": "S03HKML0",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03HKML0_.*"
                },
                {
                    "name": "S03HKM2L0",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03HKM2L0($|_.*)"
                },
                {
                    "name": "S03HKMRAW",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03HKMRAW($|_.*)"
                },
                {
                    "name": "S03NATL0",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03NATL0_.*"
                },
                {
                    "name": "S03OLCL0",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03OLCL0_.*"
                },
                {
                    "name": "S03SLSL0",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03SLSL0_.*"
                },
                {
                    "name": "S03SRAL0",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03SRAL0_.*"
                },
                {
                    "name": "S03SRAL0C",
                    "mode": "always",
                    "mandatory": false,
                    "regex": "S03SRAL0C($|_.*)"
                },
                {
                    "name": "S03MWRL0",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03MWRL0_.*"
                },
                {
                    "name": "S03GNSL0",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03GNSL0_.*"
                },
                {
                    "name": "S03DORNAV",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03DORNAV($|_.*)"
                },
                {
                    "name": "S03DORDOP",
                    "mode": "always",
                    "mandatory": true,
                    "regex": "^S03DORDOP($|_.*)"
                },
                {
                    "name": "S03OLCCR0",
                    "mode": "always",
                    "mandatory": false,
                    "regex": "^S03OLCCR0($|_.*)"
                },
                {
                    "name": "S03OLCCR1",
                    "mode": "always",
                    "mandatory": false,
                    "regex": "^S03OLCCR1($|_.*)"
                }
            ]
        }
    ],
    "io": {
        "input": [
            {
                "name": "S3ACADUS",
                "type": "file",
                "engine": "cadu"
            }
        ],
        "adfs": [
            {
                "name": "osf",
                "type": "file",
                "engine": "cpm_safe",
                "alternatives": [
                    {
                        "order": 1,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
                            "parameters": {
                                "product_type": "AX___OSF_AX",
                                "start_datetime": "{external_variable.start_datetime}",
                                "end_datetime": "{external_variable.end_datetime}",
                                "satellite": "{external_variable.satellite}",
                                "dTa": 6000,
                                "dTb": 6000
                            }
                        }
                    }
                ]
            },
            {
                "name": "fro",
                "type": "file",
                "engine": "cpm_safe",
                "alternatives": [
                    {
                        "order": 1,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
                            "parameters": {
                                "product_type": "AX___FRO_AX",
                                "start_datetime": "{external_variable.start_datetime}",
                                "end_datetime": "{external_variable.end_datetime}",
                                "satellite": "{external_variable.satellite}",
                                "dTa": 7000,
                                "dTb": 7000
                            }
                        }
                    }
                ]
            }
        ],
        "output": [
            {
                "name": "S03HKM2L0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03HKML0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03HKMRAW",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03NATL0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03OLCL0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03SLSL0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03SRAL0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03SRAL0C",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03MWRL0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03GNSL0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03DORNAV",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03DORDOP",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03OLCCR0",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            },
            {
                "name": "S03OLCCR1",
                "type": "folder",
                "engine": "cpm_zarr",
                "writer_params": {
                    "mode": "w"
                }
            }
        ]
    },
    "queries": [
        {
            "name": "LatestValCover",
            "parameters": [
                "product_type",
                "start_datetime",
                "end_datetime",
                "satellite",
                "dTa",
                "dTb"
            ],
            "stac": {
                "filter": {
                    "op": "and",
                    "args": [
                        {
                            "op": "=",
                            "args": [
                                {
                                    "property": "product:type"
                                },
                                "{product_type}"
                            ]
                        },
                        {
                            "op": "=",
                            "args": [
                                {
                                    "property": "platform"
                                },
                                "{satellite}"
                            ]
                        },
                        {
                            "op": "t_contains",
                            "args": [
                                {
                                    "interval": [
                                        {
                                            "property": "start_datetime"
                                        },
                                        {
                                            "property": "end_datetime"
                                        }
                                    ]
                                },
                                {
                                    "interval": [
                                        {
                                            "op": "-",
                                            "args": [
                                                "{start_datetime}",
                                                "{dTa}"
                                            ]
                                        },
                                        {
                                            "op": "+",
                                            "args": [
                                                "{end_datetime}",
                                                "{dTb}"
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "sortby": [
                    {
                        "field": "created",
                        "direction": "desc"
                    }
                ],
                "limit": 1
            }
        }
    ],
    "pipelines": [
        {
            "name": "s3_l0_full",
            "description": "Full pipeline for S3 L0",
            "steps": [
                {
                    "unit_name": "S3L0Processor",
                    "step_id": 1,
                    "input_products": {
                        "S3ACADUS": "pipeline_input"
                    },
                    "output_products": {
                        "S03HKM2L0": "pipeline_output",
                        "S03HKML0": "pipeline_output",
                        "S03HKMRAW": "pipeline_output",
                        "S03NATL0": "pipeline_output",
                        "S03OLCL0": "pipeline_output",
                        "S03SLSL0": "pipeline_output",
                        "S03SRAL0": "pipeline_output",
                        "S03SRAL0C": "pipeline_output",
                        "S03MWRL0": "pipeline_output",
                        "S03GNSL0": "pipeline_output",
                        "S03DORNAV": "pipeline_output",
                        "S03DORDOP": "pipeline_output",
                        "S03OLCCR0": "pipeline_output",
                        "S03OLCCR1": "pipeline_output"
                    },
                    "parameters": {
